
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local VirtualUser = game:GetService("VirtualUser")


_G.AutoChest = true -- Bật/Tắt script (Chuyển thành false  (Notification)
local function notify(title, text)
    game:GetService("StarterGui"):SetCore("SendNotification", {
        Title = title,
        Text = text,
        Duration = 10
    })
end


local function hasSpecialItem()
    local character = LocalPlayer.Character
    local backpack = LocalPlayer.Backpack
    
    
    local specialItems = {"Fist of Darkness", "God's Chalice"}
    
    for _, itemName in ipairs(specialItems) do
        
        if backpack:FindFirstChild(itemName) or (character and character:FindFirstChild(itemName)) then
            return itemName
        end
    end
    return nil
end


LocalPlayer.Idled:Connect(function()
    VirtualUser:Button2Down(Vector2.new(0,0), workspace.CurrentCamera.CFrame)
    wait(1)
    VirtualUser:Button2Up(Vector2.new(0,0), workspace.CurrentCamera.CFrame)
end)

notify("Auto Chest", "Script đã được kích hoạt!")


spawn(function()
    while _G.AutoChest do
        wait(0.1)
        
        
        local itemFound = hasSpecialItem()
        if itemFound then
            _G.AutoChest = false -- Tắt vòng lặp vĩnh viễn
            
  
            if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
                LocalPlayer.Character.HumanoidRootPart.Velocity = Vector3.new(0,0,0)
            end
            
    
            for i = 1, 5 do
                notify("⚠️ ĐÃ TÌM THẤY ĐỒ QUÝ! ⚠️", "Bạn đã nhặt được: " .. itemFound .. "! Script đã TỰ ĐỘNG DỪNG để bảo vệ vật phẩm.")
                wait(2)
            end
            break 
        
        
        
        local character = LocalPlayer.Character
        if character Cervical and character:FindFirstChild("HumanoidRootPart") then
            local rootPart = character.HumanoidRootPart
            
            for _, object in pairs(workspace:GetChildren()) do
                
                if object.Name:find("Chest") and object:IsA("BasePart") then
                    -- Kiểm tra lại 
                    if hasSpecialItem() then break end
                    
          
                    repeat
                        if not _G.AutoChest or hasSpecialItem() then break end
                        rootPart.CFrame = object.CFrame
                        wait(0.1)
                    until not object:IsDescendantOf(workspace) 
  
                end
            end
        end
    end
end)
